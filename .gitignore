.venv/
__pycache__/
*.pyc
tests/smoke_out/

# 真实敏感素材（合同扫描件、真实印章/签名）永不入库
/*.jpg
/*.jpeg
/*.png
/*.bmp
/*.tif
/*.tiff
/*.exe
/*_已盖章_*
*.sealog

# 构建产物（PyInstaller / setuptools）——绝不入库
build/
dist/
_internal/
*.egg-info/
.pytest_cache/
.ruff_cache/

# 测试素材：脚本生成，不入库（tests/conftest.py 缺了会自动生成）
/tests/fixtures/*.jpg
/tests/fixtures/*.png
